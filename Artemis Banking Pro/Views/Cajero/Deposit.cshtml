@using ABP.Core.Application.Dtos
@model DepositDto
@{
    ViewData["Title"] = "Depósito";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
<style>
    body {font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #0f2027, #203a43, #2c5364); color:#fff;}
    .form-container {background: rgba(255,255,255,0.1); backdrop-filter:blur(10px); border-radius:12px; padding:2rem; max-width:500px; margin:auto;}
    input, button {width:100%; padding:0.8rem; margin-top:0.5rem; border:none; border-radius:6px;}
    button {background:#ff6b6b; color:#fff; cursor:pointer; transition:background .2s;}
    button:hover {background:#ff4757;}
</style>
<h1>Depósito</h1>
<div class="form-container">
    <form asp-action="Deposit" method="post">
        <label>Cuenta destino</label>
        <input asp-for="DestinationAccountNumber" />
        <label>Monto</label>
        <input asp-for="Amount" type="number" step="0.01" />
        <button type="submit">Realizar Depósito</button>
    </form>
</div>
