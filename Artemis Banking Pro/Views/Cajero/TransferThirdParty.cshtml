@using ABP.Core.Application.Dtos.Cashier
@model ThirdPartyTransferDto

@{ ViewData["Title"] = "Transferencia a Terceros"; }

<h2 class="title">@ViewData["Title"]</h2>

<form asp-action="TransferThirdParty" method="post" class="form">
    <div class="form-group">
        <label asp-for="SourceAccountNumber"></label>
        <input asp-for="SourceAccountNumber" class="form-control" placeholder="Cuenta origen" />
        <span asp-validation-for="SourceAccountNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DestinationAccountNumber"></label>
        <input asp-for="DestinationAccountNumber" class="form-control" placeholder="Cuenta destino" />
        <span asp-validation-for="DestinationAccountNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Amount"></label>
        <input asp-for="Amount" class="form-control" placeholder="Monto" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Transferir</button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
