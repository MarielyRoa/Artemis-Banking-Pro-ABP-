@using ABP.Core.Application.Dtos.Cashier
@model LoanPaymentDto

@{ ViewData["Title"] = "Pago de Préstamo"; }

<h2 class="title">@ViewData["Title"]</h2>

<form asp-action="PayLoan" method="post" class="form">
    <div class="form-group">
        <label asp-for="LoanNumber"></label>
        <input asp-for="LoanNumber" class="form-control" placeholder="Número de préstamo" />
        <span asp-validation-for="LoanNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Amount"></label>
        <input asp-for="Amount" class="form-control" placeholder="Monto" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Pagar</button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
