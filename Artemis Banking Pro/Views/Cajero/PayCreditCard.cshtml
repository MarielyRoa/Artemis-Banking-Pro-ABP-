@using ABP.Core.Application.Dtos.Cashier
@model CreditCardPaymentDto

@{ ViewData["Title"] = "Pago con Tarjeta de Crédito"; }

<h2 class="title">@ViewData["Title"]</h2>

<form asp-action="PayCreditCard" method="post" class="form">
    <div class="form-group">
        <label asp-for="CreditCardNumber"></label>
        <input asp-for="CreditCardNumber" class="form-control" placeholder="Número de tarjeta" />
        <span asp-validation-for="CreditCardNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Amount"></label>
        <input asp-for="Amount" class="form-control" placeholder="Monto" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Pagar</button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
